rules_version = '2';

function getUsername(uid) {
  return get(/databases/$(database)/documents/users/$(uid)).data.username;
}

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /messages/{messageId} {
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      
      allow read: if request.auth != null && 
                   (request.resource.data.senderUsername == getUsername(request.auth.uid) || 
                    request.resource.data.recipientUsername == getUsername(request.auth.uid));

      // Deny listing all messages, updates, and deletes for security.
      allow list, update, delete: if false;
    }
  }
}
